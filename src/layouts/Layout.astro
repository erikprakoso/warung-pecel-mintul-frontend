---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Sego Pecel Mbak Mintul - Warung Nasi Pecel Madiun Asli",
    description = "Nikmati Nasi Pecel Madiun otentik, Lontong Pecel, dan Sate legendaris di Warung Pecel Mbak Mintul. Authentic Traditional Pecel Madiun (Indonesian Peanut Sauce Salad).",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content="nasi pecel, warung pecel, pecel madiun, sego pecel, kuliner madiun, sate, lontong pecel, warung makan, mbak mintul, pecel rice, indonesian salad, peanut sauce salad"
        />
        <meta
            name="google-site-verification"
            content="o3T13gjXdwO7J4H5lTJm893UX7ldJAkLonUBa95P3kM"
        />
        <link rel="canonical" href={Astro.url} />

        <!-- Open Graph / Facebook -->
        <meta property="og:site_name" content="Sego Pecel Mbak Mintul" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content="https://www.pecelmintul.my.id/images/sego-pecel-mbak-mintul-banner.webp"
        />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta
            property="twitter:image"
            content="https://www.pecelmintul.my.id/images/sego-pecel-mbak-mintul-banner.webp"
        />

        <title>{title}</title>

        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Restaurant",
                name: "Warung Sego Pecel Mbak Mintul",
                image: "https://www.pecelmintul.my.id/images/sego-pecel-mbak-mintul-banner.webp",
                description:
                    "Warung Pecel Madiun asli menyajikan Nasi Pecel, Lontong Pecel, dan aneka Sate. Serving authentic Nasi Pecel Madiun (Indonesian Vegetable Salad with Peanut Sauce).",
                address: {
                    "@type": "PostalAddress",
                    streetAddress: "XWC5+GJ9, Nglawu",
                    addressLocality: "Grobogan",
                    addressRegion: "Jawa Tengah",
                    postalCode: "58153",
                    addressCountry: "ID",
                },
                geo: {
                    "@type": "GeoCoordinates",
                    latitude: -7.0287532,
                    longitude: 110.9091101,
                },
                url: "https://www.pecelmintul.my.id",
                priceRange: "Rp 5.000 - Rp 50.000",
                servesCuisine: ["Indonesian", "Javanese", "Pecel Madiun"],
                telephone: "+6287823510396",
                openingHoursSpecification: [
                    {
                        "@type": "OpeningHoursSpecification",
                        dayOfWeek: [
                            "Monday",
                            "Tuesday",
                            "Wednesday",
                            "Thursday",
                            "Friday",
                            "Saturday",
                            "Sunday",
                        ],
                        opens: "17:00",
                        closes: "01:00",
                    },
                ],
                menu: "https://www.pecelmintul.my.id/#menu",
            })}
        />

        <!-- Google Fonts: Outfit -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />

        <!-- AOS Animation CSS -->
        <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    </head>
    <body
        class="font-sans antialiased overflow-x-hidden w-full selection:bg-primary selection:text-white"
    >
        <slot />

        <!-- Initialize AOS -->
        <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
        <script is:inline>
            AOS.init({
                duration: 800,
                once: true,
                offset: 100,
                easing: "ease-out-cubic",
            });
        </script>
    </body>
</html>
